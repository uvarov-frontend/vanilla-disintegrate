---
import { getCollection, getEntry, render } from 'astro:content';

import InteractiveDemo from '../../../components/InteractiveDemo.astro';
import NotFoundPage from '../../../components/NotFoundPage.astro';
import { isLocale, localeFromPath } from '../../../i18n';
import { localeEntries } from '../../../lib/docs';
import DocsLayout from '../../../layouts/DocsLayout.astro';

const { locale, path } = Astro.params;
const pageLocale = isLocale(locale) && locale !== 'en' ? locale : localeFromPath(Astro.url.pathname);
const invalidRoute = !isLocale(locale) || locale === 'en' || !path;
const entry = invalidRoute ? undefined : await getEntry('docs', `${pageLocale}/${path}`);
const isNotFound = invalidRoute || entry === undefined;
if (isNotFound) Astro.response.status = 404;

const entries = entry ? localeEntries(await getCollection('docs'), pageLocale) : [];
const rendered = entry ? await render(entry) : null;
---

{
  rendered && entry ? (
    <DocsLayout entry={entry} entries={entries} headings={rendered.headings} locale={pageLocale}>
      <rendered.Content components={{ Demo: InteractiveDemo }} />
    </DocsLayout>
  ) : (
    <NotFoundPage locale={pageLocale} pathname={Astro.url.pathname} />
  )
}
