{
  "name": "vanilla-disintegrate",
  "version": "0.1.0",
  "description": "A lightweight, framework-agnostic Thanos snap effect with smooth layout transitions and optional sound.",
  "keywords": [
    "animation",
    "disintegrate",
    "particles",
    "thanos-snap",
    "vanilla-js",
    "typescript",
    "web-animations",
    "snapdom"
  ],
  "homepage": "https://github.com/uvarov-frontend/vanilla-disintegrate#readme",
  "bugs": "https://github.com/uvarov-frontend/vanilla-disintegrate/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uvarov-frontend/vanilla-disintegrate.git"
  },
  "author": {
    "name": "Yury Uvarov",
    "email": "uvarov.frontend@gmail.com",
    "url": "https://frontend.uvarov.tech"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core-entry.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./sound": "./dist/sounds/disintegrate.mp3",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SOUND_LICENSE.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts --mode es && vite build --config vite.lib.config.ts --mode core-es && vite build --config vite.lib.config.ts --mode cjs && vite build --config vite.lib.config.ts --mode core-cjs && vite build --config vite.iife.config.ts && node scripts/copy-sound.mjs",
    "build:demo": "vite build",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke && npm run build:demo && npm run size",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "size": "node scripts/size.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@zumer/snapdom": "^2.24.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.2",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
