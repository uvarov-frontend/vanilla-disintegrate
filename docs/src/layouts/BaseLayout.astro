---
import favicon from '../assets/favicon.svg?url';
import latoBlack from '../assets/fonts/Lato/Lato-Black.woff2?url';
import latoBold from '../assets/fonts/Lato/Lato-Bold.woff2?url';
import latoHairline from '../assets/fonts/Lato/Lato-Hairline.woff2?url';
import latoHeavy from '../assets/fonts/Lato/Lato-Heavy.woff2?url';
import latoLight from '../assets/fonts/Lato/Lato-Light.woff2?url';
import latoMedium from '../assets/fonts/Lato/Lato-Medium.woff2?url';
import latoRegular from '../assets/fonts/Lato/Lato-Regular.woff2?url';
import latoSemibold from '../assets/fonts/Lato/Lato-Semibold.woff2?url';
import latoThin from '../assets/fonts/Lato/Lato-Thin.woff2?url';
import '../styles/site.css';
import '../styles/docs.css';

import { locales, switchLocalePath, type Locale } from '../i18n';
import { absoluteUrl as toAbsoluteUrl } from '../lib/site-url';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pageClass?: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page, joined with the site node in one graph. */
  structuredData?: readonly Record<string, unknown>[];
}

const { title, description, locale, pageClass = '', noindex = false, structuredData = [] } = Astro.props;
const pathname = Astro.url.pathname;
const absoluteUrl = (href: string) => toAbsoluteUrl(Astro, href);
const fontUrls = [
  latoHairline,
  latoThin,
  latoLight,
  latoRegular,
  latoMedium,
  latoSemibold,
  latoBold,
  latoHeavy,
  latoBlack,
];

// Crawlers reject relative image paths, so the preview is resolved against the
// canonical origin. The query is bumped whenever the file changes: Facebook and
// Telegram cache a scraped image by URL and will not refetch the same one.
const previewImage = absoluteUrl('/readme-preview.html.png?v2');
const openGraphLocales: Readonly<Record<Locale, string>> = {
  en: 'en_US',
  ko: 'ko_KR',
  ru: 'ru_RU',
  zh: 'zh_CN',
};

// One graph per page: nodes reference the site by @id instead of repeating it.
// `<` is escaped because the JSON is written into an HTML element, where a bare
// `</script` inside any string would end the block early.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': absoluteUrl('/#website'),
      name: 'Vanilla Disintegrate',
      url: absoluteUrl('/'),
      inLanguage: locale,
    },
    ...structuredData,
  ],
}).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={favicon} />
    {fontUrls.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />)}
    {!noindex && <link rel="canonical" href={absoluteUrl(pathname)} />}
    {
      !noindex &&
        locales.map((target) => (
          <link rel="alternate" hreflang={target} href={absoluteUrl(switchLocalePath(pathname, target))} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={absoluteUrl(switchLocalePath(pathname, 'en'))} />}
    <title>{title}</title>
    {
      !noindex && (
        <Fragment>
          <meta property="og:type" content={pathname.includes('/docs/') ? 'article' : 'website'} />
          <meta property="og:site_name" content="Vanilla Disintegrate" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={absoluteUrl(pathname)} />
          <meta property="og:locale" content={openGraphLocales[locale]} />
          {locales
            .filter((target) => target !== locale)
            .map((target) => (
              <meta property="og:locale:alternate" content={openGraphLocales[target]} />
            ))}
          <meta property="og:image" content={previewImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="3000" />
          <meta property="og:image:height" content="1000" />
          <meta property="og:image:alt" content="A card dissolving into particles with the scatter effect" />
          <meta name="twitter:card" content="summary_large_image" />
          <script type="application/ld+json" is:inline set:html={jsonLd} />
        </Fragment>
      )
    }
  </head>
  <body class={pageClass} data-locale={locale}>
    <slot />
    <script>
      import { setupSite } from '../client/site';

      setupSite();
    </script>
  </body>
</html>
