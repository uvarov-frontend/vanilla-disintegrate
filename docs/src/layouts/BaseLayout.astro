---
import favicon from '../../../demo/favicon.svg?url';
import '../../../demo/style.css';
import '../styles/docs.css';

import { locales, switchLocalePath, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pageClass?: string;
  noindex?: boolean;
}

const { title, description, locale, pageClass = '', noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const base = Astro.site ?? new URL(Astro.url.origin);
const absoluteUrl = (href: string) => new URL(href, base).href;

// Crawlers reject relative image paths, so the preview is resolved against the
// canonical origin. The query is bumped whenever the file changes: Facebook and
// Telegram cache a scraped image by URL and will not refetch the same one.
const previewImage = absoluteUrl('/readme-preview.html.png?v1');
const openGraphLocales: Readonly<Record<Locale, string>> = {
  en: 'en_US',
  ko: 'ko_KR',
  ru: 'ru_RU',
  zh: 'zh_CN',
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={favicon} />
    {!noindex && <link rel="canonical" href={absoluteUrl(pathname)} />}
    {
      !noindex &&
        locales.map((target) => (
          <link rel="alternate" hreflang={target} href={absoluteUrl(switchLocalePath(pathname, target))} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={absoluteUrl(switchLocalePath(pathname, 'en'))} />}
    <title>{title}</title>
    {
      !noindex && (
        <Fragment>
          <meta property="og:type" content={pathname.includes('/docs/') ? 'article' : 'website'} />
          <meta property="og:site_name" content="Vanilla Disintegrate" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={absoluteUrl(pathname)} />
          <meta property="og:locale" content={openGraphLocales[locale]} />
          {locales
            .filter((target) => target !== locale)
            .map((target) => (
              <meta property="og:locale:alternate" content={openGraphLocales[target]} />
            ))}
          <meta property="og:image" content={previewImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="3000" />
          <meta property="og:image:height" content="1000" />
          <meta property="og:image:alt" content="A card dissolving into particles with the scatter effect" />
          <meta name="twitter:card" content="summary_large_image" />
        </Fragment>
      )
    }
    <!-- Yandex.Metrika counter -->
    <script type="text/javascript" is:inline>
      (function (m, e, t, r, i, k, a) {
        m[i] =
          m[i] ||
          function () {
            (m[i].a = m[i].a || []).push(arguments);
          };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) {
            return;
          }
        }
        ((k = e.createElement(t)),
          (a = e.getElementsByTagName(t)[0]),
          (k.async = 1),
          (k.src = r),
          a.parentNode.insertBefore(k, a));
      })(window, document, 'script', 'https://mc.webvisor.org/metrika/tag_ww.js?id=112076480', 'ym');

      ym(112076480, 'init', {
        ssr: true,
        webvisor: true,
        trackHash: true,
        clickmap: true,
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true,
      });
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body class={pageClass} data-locale={locale}>
    <slot />
    <script>
      import { setupSite } from '../client/site';

      setupSite();
    </script>
  </body>
</html>
