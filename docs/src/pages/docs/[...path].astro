---
import { getCollection, getEntry, render } from 'astro:content';

import InteractiveDemo from '../../components/InteractiveDemo.astro';
import { localeEntries } from '../../lib/docs';
import DocsLayout from '../../layouts/DocsLayout.astro';

const path = Astro.params.path;
if (!path) return Astro.redirect('/docs/learn/installation/');

const entry = await getEntry('docs', `en/${path}`);
if (!entry) return Astro.redirect('/404/');

const entries = localeEntries(await getCollection('docs'), 'en');
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} entries={entries} headings={headings} locale="en">
  <Content components={{ Demo: InteractiveDemo }} />
</DocsLayout>
