---
import packageJson from '../../../package.json';

import { docsHref, homeHref, ui, type Locale } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const copy = ui[locale];
const isDocumentation = pathname.includes('/docs/');
const isReference = pathname.includes('/reference/');
const mobileNavigationId = isDocumentation ? 'docs-mobile-navigation' : 'site-mobile-navigation';
const releasesHref = 'https://github.com/uvarov-frontend/vanilla-disintegrate/releases';
const sponsorHref = 'https://buymeacoffee.com/uvarov';
---

<header class="docs-header">
  <div class="header-inner">
    <button
      class="menu-button"
      type="button"
      aria-label={copy.menu}
      aria-controls={mobileNavigationId}
      aria-expanded="false"
      data-menu-button
    >
      <span></span><span></span><span></span>
    </button>
    <a class="brand" href={homeHref(locale)} aria-label="Vanilla Disintegrate">
      <Logo />
      <span>Vanilla Disintegrate</span>
    </a>
    <a
      class="package-version"
      href={releasesHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Vanilla Disintegrate v${packageJson.version}: all releases on GitHub`}
    >
      v{packageJson.version}
    </a>
    <nav class="top-navigation" aria-label="Primary navigation">
      <a
        href={docsHref(locale, 'learn/installation')}
        aria-current={isDocumentation && !isReference ? 'true' : undefined}
      >
        {copy.learn}
      </a>
      <a href={docsHref(locale, 'reference/api')} aria-current={isReference ? 'true' : undefined}>
        {copy.reference}
      </a>
      <a class="sponsor-link" href={sponsorHref} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="m8 14.25.345.666a.75.75 0 0 1-.69 0l-.008-.004-.018-.01a7 7 0 0 1-.31-.17 22 22 0 0 1-3.434-2.414C2.045 10.731 0 8.35 0 5.5 0 2.836 2.086 1 4.25 1 5.797 1 7.153 1.802 8 3.02 8.847 1.802 10.203 1 11.75 1 13.914 1 16 2.836 16 5.5c0 2.85-2.045 5.231-3.885 6.818a22 22 0 0 1-3.744 2.584l-.018.01-.006.003h-.002ZM4.25 2.5c-1.336 0-2.75 1.164-2.75 3 0 2.15 1.58 4.144 3.365 5.682A20.6 20.6 0 0 0 8 13.393a20.6 20.6 0 0 0 3.135-2.211C12.92 9.644 14.5 7.65 14.5 5.5c0-1.836-1.414-3-2.75-3-1.373 0-2.609.986-3.029 2.456a.749.749 0 0 1-1.442 0C6.859 3.486 5.623 2.5 4.25 2.5"
          ></path>
        </svg>
        {copy.sponsor}
      </a>
      <div class="github-navigation-item">
        <a href="https://github.com/uvarov-frontend/vanilla-disintegrate" target="_blank" rel="noopener noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <aside class="github-star-prompt" data-github-star-prompt hidden>
          <i aria-hidden="true"></i>
          <button type="button" aria-label={copy.close} data-github-star-close>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="m4 4 8 8m0-8-8 8"></path>
            </svg>
          </button>
          <p>{copy.githubStarPrompt}</p>
        </aside>
      </div>
    </nav>
    <LanguageSwitcher locale={locale} pathname={pathname} />
  </div>
</header>
{
  !isDocumentation && (
    <>
      <div class="mobile-nav-backdrop" aria-hidden="true" data-mobile-nav-backdrop />
      <nav
        id={mobileNavigationId}
        class="mobile-site-navigation"
        aria-label={copy.navigation}
        aria-hidden="true"
        inert
        data-mobile-nav
      >
        <span>{copy.navigation}</span>
        <a href={homeHref(locale)}>
          {copy.homeLink}
          <b aria-hidden="true">→</b>
        </a>
        <a href={docsHref(locale, 'learn/installation')}>
          {copy.learn}
          <b aria-hidden="true">→</b>
        </a>
        <a href={docsHref(locale, 'reference/api')}>
          {copy.reference}
          <b aria-hidden="true">→</b>
        </a>
        <a href="https://github.com/uvarov-frontend/vanilla-disintegrate" target="_blank" rel="noopener noreferrer">
          GitHub<b aria-hidden="true">↗</b>
        </a>
        <a href={sponsorHref} target="_blank" rel="noopener noreferrer">
          {copy.sponsor}
          <b aria-hidden="true">↗</b>
        </a>
      </nav>
    </>
  )
}
