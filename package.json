{
  "name": "vanilla-disintegrate",
  "version": "0.1.0",
  "description": "Lightweight, framework-agnostic DOM removal and restoration animations with pluggable snapshot capture.",
  "keywords": [
    "animation",
    "disintegrate",
    "particles",
    "restore",
    "thanos-snap",
    "vanilla-js",
    "typescript",
    "web-animations",
    "snapdom"
  ],
  "homepage": "https://github.com/uvarov-frontend/vanilla-disintegrate#readme",
  "bugs": "https://github.com/uvarov-frontend/vanilla-disintegrate/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uvarov-frontend/vanilla-disintegrate.git"
  },
  "author": {
    "name": "Yury Uvarov",
    "email": "uvarov.frontend@gmail.com",
    "url": "https://frontend.uvarov.tech"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SOUND_LICENSE.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "pnpm run build && astro dev",
    "build": "vite build --config vite.lib.config.ts && vite build --config vite.iife.config.ts && node scripts/write-bundle-size.mjs",
    "build:demo": "pnpm run build && astro build",
    "check": "pnpm run check:library && pnpm run check:docs",
    "check:docs": "astro check && pnpm run build:demo && pnpm run docs:smoke",
    "check:library": "pnpm run format && pnpm run lint && pnpm run typecheck:library && pnpm run test && pnpm run build && pnpm run smoke && pnpm run size",
    "docs:smoke": "node scripts/docs-smoke.mjs",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "astro preview",
    "size": "node scripts/size.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && astro check",
    "typecheck:library": "tsc --noEmit",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "@zumer/snapdom": "^2.24.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/node": "^11.1.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "astro": "^7.2.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.2",
    "globals": "^16.3.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
