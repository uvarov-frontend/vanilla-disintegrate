---
import packageJson from '../../../package.json';
import { renderParticlePlayground } from '../client/particle-playground';
import { docsHref, type Locale, ui } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl } from '../lib/site-url';
import AnimatedText from './AnimatedText.astro';
import BundleSizePanel from './BundleSizePanel.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PackageInstall from './PackageInstall.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const pathname = Astro.url.pathname;
const [descriptionBeforeHighlight, descriptionAfterHighlight] = copy.home.description.split(
  copy.home.descriptionHighlight,
);
const [playgroundDescriptionBeforeHighlight, playgroundDescriptionAfterHighlight] =
  copy.home.playgroundDescription.split(copy.home.playgroundDescriptionHighlight);
const heroAnimatedWords = {
  en: ['Modern,', 'striking,'],
  ko: ['현대적이고', '인상적이며,'],
  ru: ['Современная,', 'эффектная,'],
  zh: ['现代、', '惊艳、'],
} as const;
const cards = {
  en: [
    ['01', 'Built-in presets', 'Choose complete removal, restoration, and matching audio.'],
    ['02', 'Restore and undo', 'Retain a removed node and put the same DOM element back.'],
    ['03', 'Custom effects', 'Build both phases with WAAPI, Canvas, WebGL, or your own renderer.'],
    ['04', 'Frameworks', 'Connect the lifecycle safely to React, Vue, Svelte, Solid, or Angular.'],
  ],
  ru: [
    ['01', 'Готовые пресеты', 'Выберите анимации удаления, восстановления и подходящий звук.'],
    ['02', 'Сохранение и восстановление', 'Сохраните удалённый узел и восстановите тот же DOM-элемент.'],
    ['03', 'Свои эффекты', 'Создайте обе фазы через WAAPI, Canvas, WebGL или свой движок.'],
    ['04', 'Фреймворки', 'Свяжите lifecycle с React, Vue, Svelte, Solid или Angular.'],
  ],
  zh: [
    ['01', '内置预设', '选择完整的删除、恢复动画与对应音频。'],
    ['02', '恢复与撤销', '保留已删除的节点，并放回同一个 DOM 元素。'],
    ['03', '自定义效果', '使用 WAAPI、Canvas、WebGL 或自己的渲染器构建两个阶段。'],
    ['04', '框架集成', '将生命周期安全接入 React、Vue、Svelte、Solid 或 Angular。'],
  ],
  ko: [
    ['01', '내장 프리셋', '삭제, 복원 애니메이션과 맞는 오디오를 함께 선택하세요.'],
    ['02', '복원과 실행 취소', '삭제한 노드를 보관하고 같은 DOM 요소를 다시 넣으세요.'],
    ['03', '사용자 효과', 'WAAPI, Canvas, WebGL 또는 자체 렌더러로 두 단계를 만드세요.'],
    ['04', '프레임워크', 'React, Vue, Svelte, Solid 또는 Angular 수명 주기에 안전하게 연결하세요.'],
  ],
} as const;

const cardTargets = ['learn/effects', 'learn/retention', 'learn/custom-effects', 'learn/frameworks'] as const;
const libraryNode = {
  '@type': 'SoftwareSourceCode',
  '@id': absoluteUrl(Astro, '/#library'),
  name: 'Vanilla Disintegrate',
  description: copy.home.description,
  url: absoluteUrl(Astro, '/'),
  codeRepository: 'https://github.com/uvarov-frontend/vanilla-disintegrate',
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'Web browser',
  license: 'https://spdx.org/licenses/MIT.html',
  version: packageJson.version,
  author: { '@type': 'Person', name: 'Yury Uvarov', url: 'https://frontend.uvarov.tech' },
  isPartOf: { '@id': absoluteUrl(Astro, '/#website') },
};
---

<BaseLayout
  title={copy.home.documentTitle}
  description={copy.home.description}
  locale={locale}
  pageClass="home-page"
  structuredData={[libraryNode]}
>
  <Header locale={locale} pathname={pathname} />
  <main class="home-main" id="main-content">
    <section class="home-hero">
      <div class="hero-glow" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <h1 aria-label={`${copy.home.title} ${copy.home.accent}`} data-disintegrating-text>
        <span class="hero-heading-hint" data-heading-hint aria-hidden="true" hidden>
          {copy.home.headingClickHint}
        </span>
        <button
          class="hero-heading-trigger"
          type="button"
          disabled
          aria-label={copy.home.headingRemoveEffect}
          aria-pressed="false"
          data-disintegrating-text-trigger
          data-remove-label={copy.home.headingRemoveEffect}
          data-restore-label={copy.home.headingRestoreEffect}
          data-snap-cursor-remove-hint={copy.home.headingRemoveHint}
          data-snap-cursor-restore-hint={copy.home.headingRestoreHint}
        >
          <AnimatedText text={copy.home.title} words={heroAnimatedWords[locale]} /><br />
          <em aria-hidden="true">{copy.home.accent}</em>
        </button>
      </h1>
      <p class="home-description">
        {descriptionBeforeHighlight}<strong>{copy.home.descriptionHighlight}</strong>{descriptionAfterHighlight}
      </p>
      <BundleSizePanel locale={locale} />
      <PackageInstall locale={locale} />
      <div class="try-divider"><span>{copy.home.tryLabel}</span></div>
    </section>

    <section class="home-playground-section" id="playground" aria-labelledby="playground-title">
      <div class="home-section-heading">
        <div><span>{copy.home.playgroundKicker}</span><h2 id="playground-title">{copy.home.playgroundTitle}</h2></div>
        <p>
          {playgroundDescriptionBeforeHighlight}<strong>{copy.home.playgroundDescriptionHighlight}</strong>{
            playgroundDescriptionAfterHighlight
          }
        </p>
      </div>
      <div data-particle-playground aria-busy="false" set:html={renderParticlePlayground(locale)} />
    </section>

    <section class="home-next-steps" aria-labelledby="next-steps-title">
      <div class="home-section-heading">
        <div><span>{copy.home.docsKicker}</span><h2 id="next-steps-title">{copy.home.docsTitle}</h2></div>
        <p>{copy.home.docsDescription}</p>
      </div>
      <div class="home-doc-cards">
        {
          cards[locale].map((card, index) => (
            <a href={docsHref(locale, cardTargets[index] ?? 'learn/installation')}>
              <>
                <b>{card[0]}</b>
                <strong>{card[1]}</strong>
                <span>{card[2]}</span>
                <i>{copy.home.openGuide} →</i>
              </>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
