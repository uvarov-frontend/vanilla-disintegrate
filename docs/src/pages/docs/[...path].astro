---
import { getCollection, getEntry, render } from 'astro:content';

import InteractiveDemo from '../../components/InteractiveDemo.astro';
import NotFoundPage from '../../components/NotFoundPage.astro';
import ParticleVortexSource from '../../components/ParticleVortexSource.astro';
import { localeEntries } from '../../lib/docs';
import DocsLayout from '../../layouts/DocsLayout.astro';

const path = Astro.params.path;
if (!path) return Astro.redirect('/docs/learn/installation/');

const entry = await getEntry('docs', `en/${path}`);
if (!entry) Astro.response.status = 404;

const entries = entry ? localeEntries(await getCollection('docs'), 'en') : [];
const rendered = entry ? await render(entry) : null;
---

{
  rendered && entry ? (
    <DocsLayout entry={entry} entries={entries} headings={rendered.headings} locale="en">
      <rendered.Content components={{ Demo: InteractiveDemo, ParticleVortexSource }} />
    </DocsLayout>
  ) : (
    <NotFoundPage locale="en" pathname={Astro.url.pathname} />
  )
}
